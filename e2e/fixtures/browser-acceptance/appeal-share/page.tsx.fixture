  if (process.env.AMAANA_BROWSER_ACCEPTANCE !== "true") notFound();
  return (
    <main className="v2-shell" style={{ minHeight: "600px", paddingTop: "3rem" }}>
      <h1>Appeal sharing acceptance</h1>
      <AppealShareUpdateFixture />
    </main>
  );
}
