import { notFound } from "next/navigation";
import { TransactionErrorStyleFixture } from "@/components/transaction-error-style-fixture";

export const dynamic = "force-dynamic";
export const metadata = { robots: { index: false, follow: false } };

export default function TransactionErrorAcceptancePage() {
  if (process.env.AMAANA_BROWSER_ACCEPTANCE !== "true") notFound();
  return (
    <div>
      <h1>Transaction error boundary stylesheet acceptance</h1>
      <TransactionErrorStyleFixture />
    </div>
  );
}
