import { notFound } from "next/navigation";
import AppealsLayout from "@/app/appeals/layout";
import { AppealCard } from "@/components/appeal-card";
import { AppealShare } from "@/components/appeal-share";

export const dynamic = "force-dynamic";
export const metadata = { robots: { index: false, follow: false } };

export default function AppealStyleFixture() {
  if (process.env.AMAANA_BROWSER_ACCEPTANCE !== "true") notFound();
  const appeal = { slug: "synthetic-style-check", title: "Synthetic appeal for style acceptance", summary: "Synthetic content used only to check card layout and progress without reading donor or beneficiary records.", category: "MEDICAL", beneficiaryLocation: "Synthetic location", goalAmount: 50000, amountRaised: 10000 };
  return <AppealsLayout><main className="v2-shell"><h1>Appeal stylesheet acceptance</h1><section className="v2-appeals-grid"><AppealCard appeal={appeal} /><AppealCard appeal={appeal} /></section><section className="v2-appeals-empty"><h3>No synthetic public appeal currently open</h3></section><section className="v2-appeal-story-grid"><h2>A synthetic verified need described across multiple lines</h2></section><section className="v2-appeal-funding-strip"><div className="v2-shell"><aside className="v2-appeal-donation-panel"><div><small>Appeal progress</small><strong>₹1,00,00,000</strong><p>raised of ₹5,00,00,000</p></div><div className="v2-appeal-funding-progress"><div className="v2-appeal-progress" aria-label="Detail funding progress"><span style={{ width: "20%" }} /></div></div><div><span className="v2-appeal-closed">Synthetic closed appeal</span></div></aside></div></section><AppealShare title="Verified Support Appeal" summary="Public sharing uses privacy-safe generic details." path="/appeals/synthetic-style-check" /></main></AppealsLayout>;
}
