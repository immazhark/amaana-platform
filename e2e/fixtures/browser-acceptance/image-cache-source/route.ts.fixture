import { readFile } from "node:fs/promises";
import path from "node:path";

export const dynamic = "force-dynamic";

// Only materialized in the disposable browser build. No database, storage or real media.
const revoked = new Set<string>();
const maxRevocations = 128;
const syntheticPng = Buffer.from("iVBORw0KGgoAAAANSUhEUgAAAEAAAABACAIAAAAlC+aJAAAAUUlEQVR42u3PMQ0AMAgAMJg47OALlVPBQdI6aFZPXPbiOAEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAYF9H2lwAd9qmKEQAAAAAElFTkSuQmCC", "base64");
const unavailable = (status = 404) => new Response(null, { status, headers: { "Cache-Control": "no-store" } });

function revocableId(params: URLSearchParams) {
  const id = params.get("id");
  return params.size === 2 && params.get("policy") === "revocable" && id && /^[a-f0-9]{32}$/.test(id) ? id : null;
}

/** Revoke only a synthetic fixture ID; never mutate an application record. */
export function POST(request: Request) {
  if (process.env.AMAANA_BROWSER_ACCEPTANCE !== "true") return unavailable();
  const id = revocableId(new URL(request.url).searchParams);
  if (!id) return unavailable();
  if (!revoked.has(id) && revoked.size >= maxRevocations) return unavailable(503);
  revoked.add(id);
  return new Response(null, { status: 204, headers: { "Cache-Control": "no-store" } });
}

/** Disposable optimizer-policy source; no beneficiary or database access. */
export async function GET(request: Request) {
  if (process.env.AMAANA_BROWSER_ACCEPTANCE !== "true") return unavailable();
  const params = new URL(request.url).searchParams;
  const policy = params.get("policy");
  if (policy === "revocable") {
    const id = revocableId(params);
    if (!id || revoked.has(id)) return unavailable();
    if (revoked.size >= maxRevocations) return unavailable(503);
    return new Response(new Uint8Array(syntheticPng), { headers: {
      "Content-Type": "image/png",
      "Content-Length": String(syntheticPng.byteLength),
      "Cache-Control": "private, no-store, max-age=0",
      "X-Content-Type-Options": "nosniff",
    } });
  }
  if (policy !== "bounded" && policy !== "immutable") return unavailable();
  try {
    const bytes = await readFile(path.join(process.cwd(), "public", "hero", "origin.webp"));
    const body = new ArrayBuffer(bytes.byteLength);
    new Uint8Array(body).set(bytes);
    return new Response(body, { headers: {
      "Content-Type": "image/webp",
      "Content-Length": String(bytes.byteLength),
      "Cache-Control": policy === "bounded" ? boundedCache : "public, max-age=31536000, immutable",
      "X-Content-Type-Options": "nosniff",
    } });
  } catch {
    return unavailable(503);
  }
}
