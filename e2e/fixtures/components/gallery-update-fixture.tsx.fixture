"use client";

import { useEffect, useState } from "react";
import { CampaignMediaGallery, type CampaignGalleryItem } from "@/components/campaign-media-gallery";

type GalleryFixtureUpdate = { action: "reverse" | "remove" | "empty"; id?: string };

export function GalleryUpdateFixture({ items }: { items: CampaignGalleryItem[] }) {
  const [visible, setVisible] = useState(items);
  useEffect(() => {
    function update(event: Event) {
      const detail = (event as CustomEvent<GalleryFixtureUpdate>).detail;
      if (detail.action === "reverse") setVisible(current => [...current].reverse());
      if (detail.action === "remove") setVisible(current => current.filter(item => item.id !== detail.id));
      if (detail.action === "empty") setVisible([]);
    }
    window.addEventListener("amaana-gallery-fixture-update", update);
    return () => window.removeEventListener("amaana-gallery-fixture-update", update);
  }, []);
  return <CampaignMediaGallery items={visible} />;
}
