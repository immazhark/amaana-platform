# Environment posture. Staging must use Razorpay Test credentials and disabled email delivery.
# Production uses the official Amaana origin and Live Razorpay credentials.
APP_ENVIRONMENT="staging"
EMAIL_DELIVERY_MODE="disabled"

# PostgreSQL connection used by Prisma. Never commit production credentials.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amaana?schema=public"

# Canonical public origin, without a trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Experimental per-navigation script nonce CSP (AF-R014).
# Disabled until streamed SSR, redirects, Razorpay and static/dynamic cache tests pass.
# Do not enable on the current public site.
AMAANA_NONCE_CSP_ENABLED="false"

# Search-indexing posture is always explicit. Keep preview/staging builds disabled.
# Production must set PRODUCTION_INDEXING_DECISION to either "keep_disabled" or "enable".
# Only "enable" may be paired with NEXT_PUBLIC_ALLOW_INDEXING="true".
PRODUCTION_INDEXING_DECISION="keep_disabled"
NEXT_PUBLIC_ALLOW_INDEXING="false"

# First-party, sampled Core Web Vitals. Disabled by default and in acceptance builds.
# Enable only after the daily aggregation migration has been deployed.
NEXT_PUBLIC_ENABLE_WEB_VITALS="false"

# One-shot / test-only acceptance switches. These must remain false in production.
STAGING_ACCEPTANCE_ON_START="false"
PUBLIC_MEDIA_ACCEPTANCE_ON_START="false"
AMAANA_BROWSER_ACCEPTANCE="false"

# Used by the notification provider in a later release.
EMAIL_FROM="Amaana Foundation <noreply@amaanafoundation.org>"
RESEND_API_KEY=""
# Protects the notification delivery endpoint. Use a different 32+ character secret.
CRON_SECRET="replace-with-a-long-random-secret"

# PRIVATE S3-compatible storage for assistance documents. Never expose this bucket publicly.
S3_REGION="ap-south-1"
S3_BUCKET="amaana-assistance-private"
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
ASSISTANCE_TOKEN_PEPPER="replace-with-a-long-random-secret"

# SEPARATE public-media storage. Do not point PUBLIC_MEDIA_S3_BUCKET at the assistance bucket.
# Credentials/region/endpoint fall back to the S3_* values above when the provider/account is shared,
# but the bucket itself is intentionally mandatory and separate.
PUBLIC_MEDIA_S3_BUCKET="amaana-public-media"
PUBLIC_MEDIA_S3_REGION=""
PUBLIC_MEDIA_S3_ENDPOINT=""
PUBLIC_MEDIA_S3_FORCE_PATH_STYLE=""
MEDIA_S3_ACCESS_KEY_ID=""
MEDIA_S3_SECRET_ACCESS_KEY=""
# HTTPS CDN/public origin for the public-media bucket, without a trailing slash.
PUBLIC_MEDIA_BASE_URL=""

# Initial staff accounts used by `npm run seed:rbac`. Use unique strong passwords.
ADMIN_MAZHAR_EMAIL="mazharkhan.it@gmail.com"
ADMIN_MAZHAR_PASSWORD=""
ADMIN_ATHER_EMAIL="ather7mak@gmail.com"
ADMIN_ATHER_PASSWORD=""
ADMIN_ASMA_EMAIL="imasmakhan2k@gmail.com"
ADMIN_ASMA_PASSWORD=""

# Direct domestic donation details. These must match Amaana's verified banking records.
NEXT_PUBLIC_DONATION_UPI_QR_URL=""
DONATION_BANK_ACCOUNT_NAME="AMAANA FOUNDATION"
DONATION_BANK_ACCOUNT_NUMBER=""
DONATION_BANK_IFSC=""
DONATION_BANK_NAME="Axis Bank"
DONATION_BANK_BRANCH=""

# Razorpay domestic INR checkout. Use separate test and live credentials.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_replace_me"
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
DONATION_TOKEN_PEPPER="replace-with-a-different-long-random-secret"

# RESERVED for future short-lived private receipt PDF capabilities, not activated.
# Exact 32 random bytes encoded as 64 hex digits. NEVER reuse DONATION_TOKEN_PEPPER.
# Do not configure on live infrastructure until a reviewed PDF endpoint ships.
RECEIPT_DOWNLOAD_ENCRYPTION_KEY=""
# Dormant: grant issuance requires both this exact flag and a configured encryption key.
# No PDF renderer or final download route exists yet; do not activate.
AMAANA_RECEIPT_PDF_ENABLED="false"
# Must be an absolute path to an audited WeasyPrint 68+ runtime with Arabic/Telugu fonts.
# Not provided by Amaana's current Alpine runtime; keep empty until rollout.
AMAANA_RECEIPT_PDF_RENDERER_BIN=""

# Optional educational Zakat estimator. Requires qualified religious/content review,
# editorial approval and explicit release before enabling. Off by default.
# Never implies Zakat is accepted for a particular donation purpose.
AMAANA_ZAKAT_ESTIMATOR_REVIEWED="false"

# Fund checkout requires reviewed definitions, compatible migrations and a release decision.
# Private controls: approval alone never activates a fund. Leave disabled by default.
AMAANA_FUND_CHECKOUT_ENABLED="false"
AMAANA_FUND_CHECKOUT_ALLOWLIST=""
AUTH_RATE_LIMIT_PEPPER="replace-with-another-long-random-secret"

# Future internal finance and donor-consent rollout gates. These require
# reviewed additive migrations, exact-head database checks and owner approval.
# Never enable them merely because their source code is present in a PR.
AMAANA_ALLOCATION_PLANNING_ENABLED="false"
AMAANA_DONOR_RECOGNITION_ENABLED="false"
AMAANA_DONOR_RIGHTS_ENABLED="false"

