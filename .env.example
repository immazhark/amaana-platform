# Environment posture. Staging must use Razorpay Test credentials and disabled email delivery.
# Production uses the official Amaana origin and Live Razorpay credentials.
APP_ENVIRONMENT="staging"
EMAIL_DELIVERY_MODE="disabled"

# PostgreSQL connection used by Prisma. Never commit production credentials.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amaana?schema=public"

# Canonical public origin, without a trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Used by the notification provider in a later release.
EMAIL_FROM="Amaana Foundation <noreply@amaanafoundation.org>"
RESEND_API_KEY=""
# Protects the notification delivery endpoint. Use a different 32+ character secret.
CRON_SECRET="replace-with-a-long-random-secret"

# PRIVATE S3-compatible storage for assistance documents. Never expose this bucket publicly.
S3_REGION="ap-south-1"
S3_BUCKET="amaana-assistance-private"
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
ASSISTANCE_TOKEN_PEPPER="replace-with-a-long-random-secret"

# SEPARATE public-media storage. Do not point PUBLIC_MEDIA_S3_BUCKET at the assistance bucket.
# Credentials/region/endpoint fall back to the S3_* values above when the provider/account is shared,
# but the bucket itself is intentionally mandatory and separate.
PUBLIC_MEDIA_S3_BUCKET="amaana-public-media"
PUBLIC_MEDIA_S3_REGION=""
PUBLIC_MEDIA_S3_ENDPOINT=""
PUBLIC_MEDIA_S3_FORCE_PATH_STYLE=""
PUBLIC_MEDIA_S3_ACCESS_KEY_ID=""
PUBLIC_MEDIA_S3_SECRET_ACCESS_KEY=""
# HTTPS CDN/public origin for the public-media bucket, without a trailing slash.
PUBLIC_MEDIA_BASE_URL=""

# Initial staff accounts used by `npm run seed:rbac`. Use unique strong passwords.
ADMIN_MAZHAR_EMAIL="mazharkhan.it@gmail.com"
ADMIN_MAZHAR_PASSWORD=""
ADMIN_ATHER_EMAIL="ather7mak@gmail.com"
ADMIN_ATHER_PASSWORD=""
ADMIN_ASMA_EMAIL="imasmakhan2k@gmail.com"
ADMIN_ASMA_PASSWORD=""

# Razorpay domestic INR checkout. Use separate test and live credentials.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_replace_me"
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
DONATION_TOKEN_PEPPER="replace-with-a-different-long-random-secret"
AUTH_RATE_LIMIT_PEPPER="replace-with-another-long-random-secret"
