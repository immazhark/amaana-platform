generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AppealStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  PAUSED
  FUNDED
  CLOSED
  REJECTED
}

enum AppealCategory {
  MEDICAL
  EDUCATION
  LIVELIHOOD
  FOOD_HARDSHIP
  HOUSING
  EMERGENCY
  OTHER
}

enum AssistanceStatus {
  SUBMITTED
  DOCUMENTS_REQUESTED
  UNDER_VERIFICATION
  APPROVED
  REJECTED
  CONVERTED_TO_APPEAL
  CLOSED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum DonationStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

model User {
  id                    String              @id @default(cuid())
  name                  String
  email                 String              @unique
  phone                 String?
  status                UserStatus          @default(INVITED)
  roles                 UserRole[]
  createdAppeals        Appeal[]            @relation("AppealCreator")
  reviewedAppeals       Appeal[]            @relation("AppealReviewer")
  assistanceAssignments AssistanceRequest[] @relation("AssistanceAssignee")
  notifications         Notification[]
  credential            PasswordCredential?
  sessions              Session[]
  auditEvents           AuditEvent[]        @relation("AuditActor")
  appealUpdates         AppealUpdate[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model PasswordCredential {
  userId       String   @id
  passwordHash String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt    DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  createdAt  DateTime @default(now())
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model UserRole {
  userId     String
  roleId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model Appeal {
  id                  String         @id @default(cuid())
  slug                String         @unique
  title               String
  summary             String
  story               String
  category            AppealCategory
  status              AppealStatus   @default(DRAFT)
  beneficiaryName     String
  beneficiaryDisplayName String?
  beneficiaryLocation String?
  coverImageUrl       String?
  isFeatured          Boolean        @default(false)
  featuredOrder       Int?
  goalAmount           Decimal        @db.Decimal(12, 2)
  amountRaised         Decimal        @default(0) @db.Decimal(12, 2)
  publishedAt          DateTime?
  closesAt             DateTime?
  createdById          String
  reviewedById        String?
  createdBy            User           @relation("AppealCreator", fields: [createdById], references: [id])
  reviewedBy           User?          @relation("AppealReviewer", fields: [reviewedById], references: [id])
  assistanceRequest    AssistanceRequest?
  notifications        Notification[]
  updates              AppealUpdate[]
  donations            Donation[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  @@index([status, publishedAt])
  @@index([category])
}

model Donation {
  id                String         @id @default(cuid())
  referenceNumber   String         @unique
  appealId          String
  donorName         String
  donorEmail        String
  donorPhone        String?
  isAnonymous       Boolean        @default(false)
  domesticConfirmedAt DateTime
  amount            Decimal        @db.Decimal(12, 2)
  refundedAmount    Decimal        @default(0) @db.Decimal(12, 2)
  currency          String         @default("INR")
  status            DonationStatus @default(CREATED)
  provider          String         @default("RAZORPAY")
  providerOrderId   String         @unique
  providerPaymentId String?        @unique
  receiptNumber     String?        @unique
  receiptTokenHash  String
  capturedAt        DateTime?
  failedAt          DateTime?
  refundedAt        DateTime?
  appeal            Appeal         @relation(fields: [appealId], references: [id])
  events            PaymentEvent[]
  notifications     Notification[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  @@index([appealId, status, createdAt])
  @@index([donorEmail, createdAt])
}

model PaymentEvent {
  id              String   @id @default(cuid())
  providerEventId String   @unique
  eventType       String
  donationId      String?
  payload         Json
  donation        Donation? @relation(fields: [donationId], references: [id], onDelete: SetNull)
  processedAt     DateTime  @default(now())
  @@index([donationId, processedAt])
}

model DonationAttempt {
  id        String   @id @default(cuid())
  clientHash String
  createdAt DateTime @default(now())
  @@index([clientHash, createdAt])
}

model DailyPageView {
  id        String   @id @default(cuid())
  path      String
  date      DateTime
  views     Int      @default(0)
  @@unique([path, date])
  @@index([date])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  subjectHash String
  succeeded  Boolean  @default(false)
  createdAt  DateTime @default(now())
  @@index([subjectHash, createdAt])
}

model AppealUpdate {
  id          String   @id @default(cuid())
  appealId    String
  authorId    String
  title       String
  content     String
  isPublic    Boolean  @default(false)
  publishedAt DateTime?
  appeal      Appeal   @relation(fields: [appealId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([appealId, isPublic, publishedAt])
}

model AssistanceRequest {
  id              String           @id @default(cuid())
  referenceNumber String           @unique
  applicantName   String
  email           String?
  phone           String
  city            String
  category        AppealCategory
  description     String
  consentGivenAt  DateTime
  trackingTokenHash String
  status          AssistanceStatus @default(SUBMITTED)
  internalNotes   String?
  assignedToId    String?
  appealId        String?          @unique
  assignedTo      User?            @relation("AssistanceAssignee", fields: [assignedToId], references: [id])
  appeal           Appeal?          @relation(fields: [appealId], references: [id])
  notifications   Notification[]
  documents       AssistanceDocument[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  @@index([status, createdAt])
  @@index([phone])
}

model AssistanceDocument {
  id                  String            @id @default(cuid())
  assistanceRequestId String
  objectKey           String            @unique
  originalName        String
  mimeType            String
  sizeBytes           Int
  assistanceRequest   AssistanceRequest @relation(fields: [assistanceRequestId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())
  @@index([assistanceRequestId])
}

model Notification {
  id                  String              @id @default(cuid())
  channel             NotificationChannel
  status              NotificationStatus  @default(PENDING)
  recipient           String
  templateKey         String
  subject             String?
  payload             Json
  scheduledFor        DateTime             @default(now())
  sentAt              DateTime?
  failureReason       String?
  attempts            Int                  @default(0)
  userId              String?
  appealId            String?
  assistanceRequestId String?
  donationId          String?
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  appeal              Appeal?              @relation(fields: [appealId], references: [id], onDelete: SetNull)
  assistanceRequest   AssistanceRequest?   @relation(fields: [assistanceRequestId], references: [id], onDelete: SetNull)
  donation            Donation?            @relation(fields: [donationId], references: [id], onDelete: SetNull)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  @@index([status, scheduledFor])
}
