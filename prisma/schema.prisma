generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AppealStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  PAUSED
  FUNDED
  CLOSED
  REJECTED
}

enum AppealCategory {
  MEDICAL
  EDUCATION
  LIVELIHOOD
  FOOD_HARDSHIP
  HOUSING
  EMERGENCY
  OTHER
}

enum AssistanceStatus {
  SUBMITTED
  DOCUMENTS_REQUESTED
  UNDER_VERIFICATION
  APPROVED
  REJECTED
  CONVERTED_TO_APPEAL
  CLOSED
}

enum AssistanceVerificationDecision {
  PENDING
  APPROVED_PUBLIC
  APPROVED_PRIVATE
  APPROVED_PARTIAL
  REFERRED
  DECLINED
}

enum ConsentDecision {
  UNCONFIRMED
  ALLOWED
  NOT_ALLOWED
  NOT_APPLICABLE
}

enum ZakatReviewStatus {
  UNREVIEWED
  ELIGIBLE
  NOT_ELIGIBLE
  NOT_APPLICABLE
}

enum ConfidentialityLevel {
  STANDARD
  CONFIDENTIAL
  HIGHLY_SENSITIVE
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum DonationStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum ContentStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  ARCHIVED
}

enum FaithContentType {
  ARTICLE
  REMINDER
  VIDEO
}

enum ReligiousReviewStatus {
  NOT_REQUIRED
  NEEDS_REVIEW
  VERIFIED
  REJECTED
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
  EXTERNAL_VIDEO
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  email                   String                   @unique
  phone                   String?
  status                  UserStatus               @default(INVITED)
  roles                   UserRole[]
  createdAppeals          Appeal[]                 @relation("AppealCreator")
  reviewedAppeals         Appeal[]                 @relation("AppealReviewer")
  assistanceAssignments   AssistanceRequest[]      @relation("AssistanceAssignee")
  assistanceVerifications AssistanceVerification[] @relation("AssistanceVerifier")
  notifications           Notification[]
  credential              PasswordCredential?
  sessions                Session[]
  auditEvents             AuditEvent[]             @relation("AuditActor")
  appealUpdates           AppealUpdate[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model PasswordCredential {
  userId       String   @id
  passwordHash String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt    DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  createdAt  DateTime @default(now())
  @@index([entityType, entityId, createdAt])
  @@index([entityType, action, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model UserRole {
  userId     String
  roleId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model Cause {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  summary      String
  description  String
  status       ContentStatus @default(DRAFT)
  isFeatured   Boolean       @default(false)
  displayOrder Int?
  publishedAt  DateTime?
  initiatives  Initiative[]
  appeals      Appeal[]
  stories      Story[]
  mediaAssets  MediaAsset[]
  faithContent FaithContent[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  @@index([status, publishedAt])
  @@index([isFeatured, displayOrder])
}

model Initiative {
  id                 String        @id @default(cuid())
  slug               String        @unique
  title              String
  summary            String
  story              String
  year               Int?
  startYear          Int?
  endYear            Int?
  status             ContentStatus @default(DRAFT)
  isFeatured         Boolean       @default(false)
  displayOrder       Int?
  primaryMetric      String?
  primaryMetricLabel String?
  financialSummary  Json?
  publishedAt        DateTime?
  causeId            String
  cause              Cause         @relation(fields: [causeId], references: [id], onDelete: Restrict)
  appeals            Appeal[]
  stories            Story[]
  mediaAssets        MediaAsset[]
  faithContent       FaithContent[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  @@index([causeId, status, publishedAt])
  @@index([isFeatured, displayOrder])
  @@index([year])
}

model Story {
  id                String        @id @default(cuid())
  slug              String        @unique
  title             String
  summary           String
  body              String
  status            ContentStatus @default(DRAFT)
  isFeatured        Boolean       @default(false)
  publishedAt       DateTime?
  sourceNote        String?
  privacyApprovedAt DateTime?
  causeId           String?
  initiativeId      String?
  cause             Cause?       @relation(fields: [causeId], references: [id], onDelete: SetNull)
  initiative        Initiative?  @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  mediaAssets       MediaAsset[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  @@index([status, publishedAt])
  @@index([causeId])
  @@index([initiativeId])
}

model FaithContent {
  id                    String                @id @default(cuid())
  slug                  String                @unique
  type                  FaithContentType
  title                 String
  excerpt               String
  body                  String?
  videoUrl              String?
  status                ContentStatus         @default(DRAFT)
  religiousReviewStatus ReligiousReviewStatus @default(NEEDS_REVIEW)
  sourceCitation        String?
  verifiedAt            DateTime?
  isFeatured            Boolean               @default(false)
  publishedAt           DateTime?
  causeId               String?
  initiativeId          String?
  cause                 Cause?                 @relation(fields: [causeId], references: [id], onDelete: SetNull)
  initiative            Initiative?            @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  topics                FaithContentTopic[]
  mediaAssets           MediaAsset[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  @@index([type, status, publishedAt])
  @@index([religiousReviewStatus])
  @@index([causeId])
  @@index([initiativeId])
}

model Topic {
  id           String              @id @default(cuid())
  slug         String              @unique
  name         String              @unique
  faithContent FaithContentTopic[]
  createdAt    DateTime            @default(now())
}

model FaithContentTopic {
  faithContentId String
  topicId        String
  faithContent   FaithContent @relation(fields: [faithContentId], references: [id], onDelete: Cascade)
  topic          Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  @@id([faithContentId, topicId])
  @@index([topicId])
}

model MediaAsset {
  id                String           @id @default(cuid())
  kind              MediaKind
  title             String?
  publicUrl         String?
  storageKey        String?
  externalUrl       String?
  altText           String?
  caption           String?
  sourcePath        String?
  sourceYear        Int?
  sortOrder         Int              @default(0)
  isPublic          Boolean          @default(false)
  privacyApprovedAt DateTime?
  causeId           String?
  initiativeId      String?
  storyId           String?
  faithContentId    String?
  cause             Cause?           @relation(fields: [causeId], references: [id], onDelete: SetNull)
  initiative        Initiative?      @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  story             Story?           @relation(fields: [storyId], references: [id], onDelete: SetNull)
  faithContent      FaithContent?    @relation(fields: [faithContentId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  @@index([causeId, isPublic, sortOrder])
  @@index([initiativeId, isPublic, sortOrder])
  @@index([storyId, isPublic, sortOrder])
  @@index([faithContentId, isPublic, sortOrder])
  @@index([isPublic, sourceYear, sortOrder, createdAt])
}

model Appeal {
  id                     String       @id @default(cuid())
  slug                   String       @unique
  title                  String
  summary                String
  story                  String
  category               AppealCategory
  status                 AppealStatus @default(DRAFT)
  beneficiaryName        String
  beneficiaryDisplayName String?
  beneficiaryLocation    String?
  coverImageUrl          String?
  isFeatured             Boolean      @default(false)
  featuredOrder          Int?
  goalAmount             Decimal      @db.Decimal(12, 2)
  amountRaised           Decimal      @default(0) @db.Decimal(12, 2)
  publishedAt            DateTime?
  closesAt               DateTime?
  causeId                String?
  initiativeId           String?
  createdById            String
  reviewedById           String?
  cause                  Cause?       @relation(fields: [causeId], references: [id], onDelete: SetNull)
  initiative             Initiative?  @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  createdBy              User         @relation("AppealCreator", fields: [createdById], references: [id])
  reviewedBy             User?        @relation("AppealReviewer", fields: [reviewedById], references: [id])
  assistanceRequest      AssistanceRequest?
  notifications          Notification[]
  updates                AppealUpdate[]
  donations              Donation[]
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  @@index([status, publishedAt])
  @@index([category])
  @@index([causeId])
  @@index([initiativeId])
  @@index([updatedAt])
}

model Donation {
  id                  String         @id @default(cuid())
  referenceNumber     String         @unique
  appealId            String
  donorName           String
  donorEmail          String
  donorPhone          String?
  isAnonymous         Boolean        @default(false)
  domesticConfirmedAt DateTime
  amount              Decimal        @db.Decimal(12, 2)
  refundedAmount      Decimal        @default(0) @db.Decimal(12, 2)
  currency            String         @default("INR")
  status              DonationStatus @default(CREATED)
  provider            String         @default("RAZORPAY")
  providerOrderId     String         @unique
  providerPaymentId   String?        @unique
  receiptNumber       String?        @unique
  receiptTokenHash    String
  capturedAt          DateTime?
  failedAt            DateTime?
  refundedAt          DateTime?
  appeal              Appeal         @relation(fields: [appealId], references: [id])
  events              PaymentEvent[]
  notifications       Notification[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  @@index([appealId, status, createdAt])
  @@index([donorEmail, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model PaymentEvent {
  id              String    @id @default(cuid())
  providerEventId String    @unique
  eventType       String
  donationId      String?
  payload         Json
  donation        Donation? @relation(fields: [donationId], references: [id], onDelete: SetNull)
  processedAt     DateTime  @default(now())
  @@index([donationId, processedAt])
}

model DonationAttempt {
  id         String   @id @default(cuid())
  clientHash String
  createdAt  DateTime @default(now())
  @@index([clientHash, createdAt])
  @@index([createdAt])
}

model DailyPageView {
  id    String   @id @default(cuid())
  path  String
  date  DateTime
  views Int      @default(0)
  @@unique([path, date])
  @@index([date])
}

model LoginAttempt {
  id          String   @id @default(cuid())
  subjectHash String
  succeeded   Boolean  @default(false)
  createdAt   DateTime @default(now())
  @@index([subjectHash, createdAt])
  @@index([createdAt])
}

model AppealUpdate {
  id          String   @id @default(cuid())
  appealId    String
  authorId    String
  title       String
  content     String
  isPublic    Boolean  @default(false)
  publishedAt DateTime?
  appeal      Appeal   @relation(fields: [appealId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([appealId, isPublic, publishedAt])
}

model AssistanceRequest {
  id                String                  @id @default(cuid())
  referenceNumber   String                  @unique
  applicantName     String
  email             String?
  phone             String
  city              String
  category          AppealCategory
  description       String
  consentGivenAt    DateTime
  trackingTokenHash String
  status            AssistanceStatus        @default(SUBMITTED)
  internalNotes     String?
  assignedToId      String?
  appealId          String?                 @unique
  assignedTo        User?                   @relation("AssistanceAssignee", fields: [assignedToId], references: [id])
  appeal             Appeal?                 @relation(fields: [appealId], references: [id])
  verification       AssistanceVerification?
  notifications     Notification[]
  documents         AssistanceDocument[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  @@index([status, createdAt])
  @@index([phone])
  @@index([createdAt])
}

model AssistanceVerification {
  id                       String                         @id @default(cuid())
  assistanceRequestId      String                         @unique
  needConfirmed            Boolean                        @default(false)
  evidenceReviewed         Boolean                        @default(false)
  verifiedNeedAmount       Decimal?                       @db.Decimal(12, 2)
  approvedPublicTarget     Decimal?                       @db.Decimal(12, 2)
  paymentDestination       String?
  otherFundingChecked      Boolean                        @default(false)
  otherFundingNotes        String?
  verificationSummary      String?
  decision                 AssistanceVerificationDecision @default(PENDING)
  confidentialityLevel     ConfidentialityLevel           @default(CONFIDENTIAL)
  publicNameConsent        ConsentDecision                @default(UNCONFIRMED)
  photoConsent             ConsentDecision                @default(UNCONFIRMED)
  medicalDetailsConsent    ConsentDecision                @default(UNCONFIRMED)
  institutionNameConsent  ConsentDecision                @default(UNCONFIRMED)
  archiveConsent           ConsentDecision                @default(UNCONFIRMED)
  zakatStatus              ZakatReviewStatus              @default(UNREVIEWED)
  reviewedById             String?
  completedAt              DateTime?
  assistanceRequest        AssistanceRequest              @relation(fields: [assistanceRequestId], references: [id], onDelete: Cascade)
  reviewedBy               User?                          @relation("AssistanceVerifier", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  @@index([decision, completedAt])
  @@index([reviewedById])
}

model AssistanceDocument {
  id                  String            @id @default(cuid())
  assistanceRequestId String
  objectKey           String            @unique
  originalName        String
  mimeType            String
  sizeBytes           Int
  assistanceRequest   AssistanceRequest @relation(fields: [assistanceRequestId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())
  @@index([assistanceRequestId])
}

model Notification {
  id                  String             @id @default(cuid())
  channel             NotificationChannel
  status              NotificationStatus @default(PENDING)
  recipient           String
  templateKey         String
  subject             String?
  payload             Json
  scheduledFor        DateTime           @default(now())
  sentAt              DateTime?
  failureReason       String?
  attempts            Int                @default(0)
  userId              String?
  appealId            String?
  assistanceRequestId String?
  donationId          String?
  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  appeal              Appeal?            @relation(fields: [appealId], references: [id], onDelete: SetNull)
  assistanceRequest   AssistanceRequest? @relation(fields: [assistanceRequestId], references: [id], onDelete: SetNull)
  donation            Donation?          @relation(fields: [donationId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  @@index([status, scheduledFor])
  @@index([status, createdAt])
}
