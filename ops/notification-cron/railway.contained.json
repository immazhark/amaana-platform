{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["ops/notification-cron/**"]
  },
  "deploy": {
    "startCommand": "node run.mjs",
    "restartPolicyType": "NEVER",
    "cronSchedule": "0 0 1 1 *"
  }
}
