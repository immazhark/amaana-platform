{
  "name": "amaana-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "seed:rbac": "node prisma/seed.mjs",
    "seed:public-content": "node prisma/seed-public-content.mjs",
    "seed:staging-acceptance": "node prisma/seed-staging-acceptance.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1128.0",
    "@aws-sdk/s3-request-presigner": "3.1128.0",
    "@prisma/client": "6.12.0",
    "next": "16.3.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.4",
    "prisma": "6.12.0",
    "typescript": "5.9.2",
    "vitest": "5.0.0"
  }
}
