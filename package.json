{
  "name": "amaana-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "seed:rbac": "node prisma/seed.mjs",
    "seed:public-content": "node prisma/seed-public-content.mjs",
    "seed:staging-acceptance": "node prisma/seed-staging-acceptance.mjs",
    "acceptance:staging": "node prisma/staging-launch-acceptance.mjs",
    "acceptance:public-media": "node prisma/staging-public-media-acceptance.mjs",
    "media:review-register": "node scripts/check-public-media-review-register.mjs",
    "media:review-readiness": "node scripts/check-public-media-review-register.mjs --readiness",
    "backgrounds:verify": "node scripts/verify-approved-backgrounds.mjs",
    "launch:status": "node scripts/check-launch-readiness.mjs",
    "launch:rehearsal": "node scripts/check-launch-readiness.mjs --rehearsal",
    "launch:production": "node scripts/check-launch-readiness.mjs --production",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "editorial:check": "node scripts/check-public-editorial-consistency.mjs",
    "launch:preflight": "node scripts/launch-preflight.mjs",
    "launch:preflight:rehearsal": "node scripts/launch-preflight.mjs --rehearsal",
    "launch:preflight:production": "node scripts/launch-preflight.mjs --production",
    "rehearsal:verify-target": "node scripts/verify-rollback-target.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1128.0",
    "@aws-sdk/s3-request-presigner": "3.1128.0",
    "@prisma/client": "6.12.0",
    "next": "16.3.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.4",
    "prisma": "6.12.0",
    "typescript": "5.9.2",
    "vitest": "5.0.0"
  }
}
